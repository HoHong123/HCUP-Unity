.hgraph-node {
    background-color: #353535;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-color: #1F1F1F;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    overflow: hidden;
    min-width: 180px;
    min-height: 64px;
}

.hgraph-node-header {
    padding-left: 10px;
    padding-right: 10px;
    flex-direction: column;
    -unity-font-style: bold;
    font-size: 10px;
    color: rgb(255, 255, 255);
}

.hgraph-node-header-row {
    height: 24px;
    flex-direction: row;
    align-items: center;
    -unity-text-align: middle-left;
}

.hgraph-node-title {
    padding-left: 4px;
    padding-bottom: 6px;
    font-size: 14px;
    color: rgb(232, 232, 232);
    -unity-text-align: middle-left;
}

/* Phase 1-B - Body / Toggle / Resize / Highlight */

.hgraph-node-toggle-arrow {
    width: 14px;
    height: 14px;
    margin-left: 2px;
    margin-right: 4px;
    color: rgb(220, 220, 220);
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hgraph-node-body {
    background-color: #2A2A2A;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    min-height: 40px;
}


.hgraph-node--selected {
    border-color: #6FA5C5;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
}

/* Phase 2 - 연결선 선택 시 연결된 노드 하이라이트 */
.hgraph-node--edge-highlight {
    border-color: #B8A55A;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
}

/* Phase 3 - CatalogNode: 청록 계열 외곽선으로 일반 노드와 시각 구분 */
.hgraph-catalog-node {
    border-color: #267A73;
}

/* Phase 3+ - HubNode: 주황 계열 외곽선으로 허브 라우팅 노드 시각 구분 */
.hgraph-hub-node {
    border-color: #B87333;
}

/* Phase 3+ - HubNode 출력 포트 세로 컬럼 (오른쪽 끝 정렬) */
.hgraph-hub-port-column {
    flex-direction: column;
    align-items: flex-end;
    margin-left: auto;
}

/* Phase 3+ - HubNode body Add 버튼 */
.hgraph-hub-add-btn {
    margin-top: 4px;
    font-size: 10px;
    -unity-text-align: middle-center;
}

/* Phase 4 - Search: 현재 검색 대상 노드 강조 (황색 3px 외곽선) */
.hgraph-node--search-active {
    border-color: #D4C643;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
}

/* HCUP-2.7.0 Phase 1 - Play 모드 실행 중 활성 노드 (녹색 3px 외곽선) */
.hgraph-node--active {
    border-color: #4CAF50;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
}

/* Phase 2 - portRow: mainContainer 직속 → GraphView collapse 관리 밖 항상 표시 */
.hgraph-node-port-row {
    flex-direction: row;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
}

/* Phase 2 - 포트 스타일: 작고 미니멀한 원형 점 */
.port {
    margin-top: 2px;
    margin-bottom: 2px;
    padding-left: 0;
    padding-right: 0;
}

.port > #connector {
    width: 10px;
    height: 10px;
    border-radius: 5px;
}
